{
  "name": "AutoPulse OBD2",
  "short_name": "AutoPulse",
  "description": "Offline-capable OBD-II diagnostics: live sensors, dashboards, DTC scanning, trips, performance tests, service functions and an ELM327 terminal.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#070b10",
  "theme_color": "#0a0f14",
  "categories": ["utilities", "productivity", "travel"],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Live data",
      "short_name": "Live",
      "url": "./#/live",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Diagnostics",
      "short_name": "DTC",
      "url": "./#/diagnostics",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Trips",
      "short_name": "Trips",
      "url": "./#/trips",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
